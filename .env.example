# Скопировать в .env и заполнить по мере поступления доступов (PROJECT.md р.10.1).
# .env в .gitignore — реальные значения НИКОГДА не коммитим.

# --- Telegram bot ---
BOT_TOKEN=                  # токен от BotFather
ADMIN_TG_IDS=               # Telegram ID владельца, через запятую (whitelist /admin)
OPEN_CHANNEL_ID=            # id/@username открытого канала (анонсы)
CLOSED_CHANNEL_ID=          # id приватного закрытого канала

# --- Google Sheets ---
GOOGLE_SA_JSON=             # путь к service account JSON
GOOGLE_SHEETS_ID=           # id таблицы (или папки)

# --- Notion ---
NOTION_TOKEN=               # Internal Integration Secret
NOTION_DB_EPISODES=         # id базы «Эпизоды»

# --- Podster / RSS ---
PODSTER_RSS_URL=            # ссылка на RSS-ленту подкаста

# --- Payments (Telegram-native) ---
PAYMENT_PROVIDER_TOKEN=     # ЮKassa provider token (для Stars не нужен)

# --- storage ---
DATABASE_URL=               # postgresql+asyncpg://user:pass@host:5432/dbname
REDIS_URL=redis://localhost:6379/0

# --- media (переопределить путь к бинарям при нужде) ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
