# Скопировать в .env и заполнить по мере поступления доступов (PROJECT.md р.10.1).
# .env в .gitignore — реальные значения НИКОГДА не коммитим.

# --- Telegram bot ---
BOT_TOKEN=                  # токен от BotFather
BOT_USERNAME=AlekhinaU_bot  # username бота без @ (для ссылок оплаты и ВК-воронки в Телеграм)
TELEGRAM_PROXY=             # опц. прокси для api.telegram.org (socks5://user:pass@host:port), если Telegram блокируется
ADMIN_TG_IDS=               # Telegram ID владельца, через запятую (whitelist /admin)
OPEN_CHANNEL_ID=            # id/@username открытого канала (анонсы)
CLOSED_CHANNEL_ID=          # id приватного закрытого канала

# --- Google Sheets ---
GOOGLE_SA_JSON=             # путь к service account JSON
GOOGLE_SHEETS_ID=           # id таблицы (или папки)

# --- Notion ---
NOTION_TOKEN=               # Internal Integration Secret
NOTION_DB_EPISODES=         # id базы «Эпизоды»

# --- ВКонтакте (верх воронки: бот в группе + посты; пусто = ВК выключен) ---
VK_GROUP_TOKEN=             # ключ доступа сообщества (Управление -> Работа с API -> Ключи доступа)
VK_GROUP_ID=                # числовой id группы (без минуса)
VK_CONFIRMATION_TOKEN=      # строка подтверждения (Callback API -> строка, которую вернуть)
VK_SECRET=                  # секретный ключ Callback API (опц., для проверки запросов)
VK_API_VERSION=5.199

# --- Podster / RSS ---
PODSTER_RSS_URL=            # ссылка на RSS-ленту подкаста

# --- Payments (ЮKassa external checkout — основной путь) ---
# Оплаты: create_payment -> confirmation_url -> вебхук /payments/yookassa -> выдача.
# Нужны ИМЕННО shop_id + secret_key (не PAYMENT_PROVIDER_TOKEN).
YOOKASSA_SHOP_ID=           # id магазина ЮKassa (Настройки -> API-ключи)
YOOKASSA_SECRET_KEY=        # секретный API-ключ ЮKassa (live_/test_)
PAYMENT_CURRENCY=RUB        # рубли

# --- Prices (опц.; по умолчанию из спеки, менять только при нужде) ---
# SUBSCRIPTION_PRICE=790
# SUBSCRIPTION_PRICE_3M=1890
# WORKBOOK_PRICE=599
# WORKBOOK_PRICE_SUBSCRIBER=359
# ALL_SEASONS_PRICE=999
# ALL_SEASONS_PRICE_SUBSCRIBER=599
# TRIAL_HOURS=24

# --- storage ---
DATABASE_URL=               # postgresql+asyncpg://user:pass@host:5432/dbname
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false             # ПРОД: true (Redis для FSM, переживает рестарт)

# --- deploy (docker-compose) ---
POSTGRES_USER=alehina
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alehina
SITE_ADDRESS=example.com    # домен для Caddy (авто-TLS вебхуков)

# --- media (переопределить путь к бинарям при нужде) ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
