# Скопировать в .env и заполнить по мере поступления доступов (PROJECT.md р.10.1).
# .env в .gitignore — реальные значения НИКОГДА не коммитим.
# Комментарии — только отдельными строками: docker compose читает env_file построчно
# и всё, что справа от «=», кладёт в значение целиком.

# --- Telegram bot ---
# токен от BotFather
BOT_TOKEN=
# username бота без @ (для ссылок оплаты и ВК-воронки в Телеграм)
BOT_USERNAME=AlekhinaU_bot
# опц. прокси для api.telegram.org (socks5://user:pass@host:port), если Telegram блокируется
TELEGRAM_PROXY=
# Telegram ID владельца, через запятую (whitelist /admin)
ADMIN_TG_IDS=
# id/@username открытого канала (анонсы)
OPEN_CHANNEL_ID=
# id приватного закрытого канала
CLOSED_CHANNEL_ID=

# --- Google Sheets ---
# путь к service account JSON (в докере — /app/secrets/service_account.json)
GOOGLE_SA_JSON=
# id таблицы (или папки)
GOOGLE_SHEETS_ID=

# --- Notion ---
# Internal Integration Secret
NOTION_TOKEN=
# id базы «Эпизоды»
NOTION_DB_EPISODES=

# --- ВКонтакте (верх воронки: бот в группе + посты; пусто = ВК выключен) ---
# ключ доступа сообщества (Управление -> Работа с API -> Ключи доступа)
VK_GROUP_TOKEN=
# числовой id группы (без минуса)
VK_GROUP_ID=
# строка подтверждения (Callback API -> строка, которую вернуть)
VK_CONFIRMATION_TOKEN=
# секретный ключ Callback API (опц., для проверки запросов)
VK_SECRET=
VK_API_VERSION=5.199

# --- Podster / RSS ---
# ссылка на RSS-ленту подкаста
PODSTER_RSS_URL=

# --- Payments (ЮKassa external checkout — основной путь) ---
# Оплаты: create_payment -> confirmation_url -> вебхук /payments/yookassa -> выдача.
# Нужны ИМЕННО shop_id + secret_key (не PAYMENT_PROVIDER_TOKEN).
# id магазина ЮKassa (Настройки -> API-ключи)
YOOKASSA_SHOP_ID=
# секретный API-ключ ЮKassa (live_/test_)
YOOKASSA_SECRET_KEY=
# рубли
PAYMENT_CURRENCY=RUB

# --- Prices (опц.; по умолчанию из спеки, менять только при нужде) ---
# SUBSCRIPTION_PRICE=790
# SUBSCRIPTION_DAYS=30
# SUBSCRIPTION_PRICE_3M=1890
# SUBSCRIPTION_DAYS_3M=90
# WORKBOOK_PRICE=599
# WORKBOOK_PRICE_SUBSCRIBER=359
# ALL_SEASONS_PRICE=999
# ALL_SEASONS_PRICE_SUBSCRIBER=599
# TRIAL_HOURS=24

# --- storage ---
# postgresql+asyncpg://user:pass@host:5432/dbname (в docker compose проставляется сам)
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# ПРОД: true (Redis для FSM, переживает рестарт)
USE_REDIS=false

# --- deploy (docker-compose) ---
POSTGRES_USER=alehina
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alehina
# домен для Caddy (авто-TLS вебхуков)
SITE_ADDRESS=example.com

# --- media (переопределить путь к бинарям при нужде) ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
